# API Base URL
# - Local development (uses Vite proxy): /api
# - Production on Vercel (uses Vercel reverse-proxy rewrites to prevent iOS WebKit ITP cookie blocking): /api
# - Direct cross-origin (requires Partitioned cookies): https://<your-render-service>.onrender.com/api
VITE_API_BASE_URL=/api

# Direct Socket.IO backend. Production needs this explicit URL; /socket.io on
# Vercel is not used. Authentication uses a fresh ticket from /api/auth/socket-ticket.
# Local development: omit this value to use Vite's WebSocket proxy.
VITE_SOCKET_URL=https://roomiematch-f8lz.onrender.com

# Temporary lifecycle diagnostics; requires rebuilding the frontend. Never logs packet bodies.
VITE_REALTIME_DEBUG=false
