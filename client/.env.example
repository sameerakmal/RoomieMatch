# API Base URL
# - Local development (uses Vite proxy): /api
# - Production (deployed Render backend): https://<your-render-service>.onrender.com/api
VITE_API_BASE_URL=https://roomiematch-api.onrender.com/api

# Real-time WebSocket URL (Optional)
# If omitted, defaults to the origin of VITE_API_BASE_URL in production or current window origin in dev.
# - Production: https://<your-render-service>.onrender.com
VITE_SOCKET_URL=https://roomiematch-api.onrender.com
