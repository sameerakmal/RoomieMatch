{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://roomiematch-f8lz.onrender.com/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://roomiematch-f8lz.onrender.com/socket.io/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}

