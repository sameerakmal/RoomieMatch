{
  "name": "roomiematch",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "concurrently -k -n client,server -c green,yellow \"npm run dev -w client\" \"npm run dev -w server\"",
    "build": "npm run build -w client && npm run build -w server",
    "test": "npm run test -w server",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint -w client"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
