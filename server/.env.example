# Environment Mode: 'production', 'development', or 'test'
NODE_ENV=production

# Server Port (Render sets this dynamically; defaults to 4000 locally)
PORT=4000

# Allowed client origin(s) for CORS and credentials.
# In production, specify the deployed Vercel URL(s) without trailing slash (comma-separated if multiple).
CLIENT_ORIGIN=https://roomeematch.vercel.app

# MongoDB Connection String (MongoDB Atlas in production).
# Format: mongodb+srv://<username>:<password>@<cluster-address>/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/roomiematch?retryWrites=true&w=majority

# JWT Secret: Cryptographically random secret of at least 32 bytes (64 hex characters).
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_cryptographically_secure_random_string_min_32_bytes

# Token & Session Expiration in seconds (default: 604800 = 7 days; max: 2592000 = 30 days)
JWT_EXPIRES_IN_SECONDS=604800

# Cookie SameSite attribute: 'lax', 'strict', or 'none'.
# - Use 'none' for cross-site deployments (e.g., frontend on vercel.app and backend on onrender.com).
#   Requires HTTPS and Secure cookies (automatically set in production).
# - Use 'lax' for local development or when frontend and backend share the same parent domain.
COOKIE_SAME_SITE=none

# Temporary lifecycle diagnostics. Disable after investigation.
REALTIME_DEBUG=false
