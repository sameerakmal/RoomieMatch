NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Optional in development: API starts in a clearly reported unconfigured state without this.
# Required in production. Use your own MongoDB connection string; never commit credentials.
MONGODB_URI=mongodb://127.0.0.1:27017/roomiematch

# REQUIRED in every environment. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Cookie lifetime and JWT expiry in seconds (default: 7 days, maximum: 30 days).
JWT_EXPIRES_IN_SECONDS=604800
# Use lax for local development and same-site production deployments.
# Truly cross-site HTTPS deployments may need none; browsers may still block third-party cookies.
COOKIE_SAME_SITE=lax
